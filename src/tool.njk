---
layout: layouts/base.njk
bodyClass: tool-page
pagination:
  data: tools
  size: 1
  alias: tool
permalink: "/{{ tool.slug }}/"
eleventyComputed:
  title: "{% if tool.from %}{{ tool.from | fmt }} to {{ tool.to | fmt }} Converter{% else %}{{ tool.name }}{% endif %}: free, no upload"
  description: "{{ tool.summary }}"
---
{%- from "icons.njk" import icon -%}
{%- set cat = categories | bySlug(tool.category) %}
{%- set fromInfo = formats[tool.from] if tool.from else null %}
{%- set toInfo = formats[tool.to] if tool.to else null %}

<section class="page-hero tool-hero">
  <div class="container narrow">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/{{ cat.slug }}-converter/">{{ cat.title }}</a><span>/</span><span aria-current="page">{{ tool | toolName }}</span>
    </nav>
    <h1>{% if tool.from %}{{ tool.from | fmt }} to {{ tool.to | fmt }} Converter{% else %}{{ tool.name }}{% endif %}</h1>
    <p class="lede">{{ tool.summary }}</p>
    <p class="byline">By <a href="/about/">{{ site.author }}</a> · Updated <time datetime="{{ site.updated }}">{{ site.updatedHuman }}</time></p>
    {%- if tool.from %}{% set dz = { from: tool.from, to: tool.to, slug: tool.slug } %}{% else %}{% set dz = { picker: false, mode: tool.action | lower, verb: tool.action, title: tool.name, icon: ("shrink" if tool.action == "Compress" else "maximize"), slug: tool.slug } %}{% endif %}
    {% include "dropzone.njk" %}
  </div>
</section>

<article class="section prose-wrap">
  <div class="container narrow prose">
    {%- if tool.from %}
    <h2>How to convert {{ tool.from | fmt }} to {{ tool.to | fmt }}</h2>
    <ol>
      <li>Drop your {{ tool.from | fmt }} files into the box above, or tap <strong>choose files</strong>.</li>
      <li>Check that <strong>{{ tool.to | fmt }}</strong> is selected, and move the quality slider if you want smaller files.</li>
      <li>Press <strong>Convert</strong>, then download each file or all of them as a ZIP.</li>
    </ol>

    {%- if fromInfo and toInfo %}
    <h2>{{ tool.from | fmt }} and {{ tool.to | fmt }} compared</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col"></th><th scope="col">{{ tool.from | fmt }}</th><th scope="col">{{ tool.to | fmt }}</th></tr></thead>
        <tbody>
          <tr><th scope="row">Full name</th><td>{{ fromInfo.full }}</td><td>{{ toInfo.full }}</td></tr>
          <tr><th scope="row">Made by</th><td>{{ fromInfo.by }}</td><td>{{ toInfo.by }}</td></tr>
          <tr><th scope="row">Type</th><td>{{ fromInfo.type }}</td><td>{{ toInfo.type }}</td></tr>
          <tr><th scope="row">Best for</th><td>{{ fromInfo.best }}</td><td>{{ toInfo.best }}</td></tr>
          <tr><th scope="row">Opens in</th><td>{{ fromInfo.support }}</td><td>{{ toInfo.support }}</td></tr>
        </tbody>
      </table>
    </div>
    {%- endif %}
    {%- endif %}

    {%- if tool.notes and tool.notes.length %}
    <h2>Good to know</h2>
    <ul class="notes">
      {%- for n in tool.notes %}<li>{{ n }}</li>{% endfor %}
    </ul>
    {%- endif %}

    <div class="callout">
      {{ icon("lock", 20) }}
      <div>
        <strong>Your files stay on your device.</strong>
        <p>This page converts files with code that runs in your browser. Nothing is uploaded. After you have used it once, it even works with your internet switched off.</p>
      </div>
    </div>

    <h2>Questions</h2>
    {%- for item in tool.faqs %}
    <details>
      <summary>{{ item.q }}</summary>
      <p>{{ item.a }}</p>
    </details>
    {%- endfor %}
  </div>
</article>

<section class="section related">
  <div class="container narrow">
    <h2>Related tools</h2>
    <ul class="chip-list">
      {%- set shown = 0 %}
      {%- for t in tools | inCategory(tool.category) %}
      {%- if t.slug != tool.slug and shown < 14 and (t.popular or (tool.from and (t.from == tool.from or t.to == tool.to))) %}
      {%- set shown = shown + 1 %}
      <li><a href="/{{ t.slug }}/">{{ t | toolName }}</a></li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>
