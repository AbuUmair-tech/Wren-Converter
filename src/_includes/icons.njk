{%- macro icon(name, size=20) -%}
<svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if name == "image" -%}<rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="9" cy="10" r="1.8"/><path d="m21 16-5-5-9 9"/>
{%- elif name == "table" -%}<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 10h18M3 15h18M10 4v16"/>
{%- elif name == "type" -%}<path d="M5 7V5h14v2M12 5v14M9 19h6"/>
{%- elif name == "music" -%}<path d="M9 18V6l11-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/>
{%- elif name == "film" -%}<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/>
{%- elif name == "archive" -%}<rect x="3" y="4" width="18" height="5" rx="1.5"/><path d="M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M10 13h4"/>
{%- elif name == "file" -%}<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>
{%- elif name == "pen" -%}<path d="m12 19 7-7 3 3-7 7zM18 13l-1.5-7.5L2 2l3.5 14.5L13 18zM2 2l7.6 7.6"/><circle cx="11" cy="11" r="2"/>
{%- elif name == "doc" -%}<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>
{%- elif name == "book" -%}<path d="M4 19.5V5a2 2 0 0 1 2-2h14v16H6.5a2.5 2.5 0 0 0 0 5H20"/>
{%- elif name == "slides" -%}<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M12 16v4M8 20h8"/>
{%- elif name == "upload" -%}<path d="M12 16V4M7 9l5-5 5 5M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
{%- elif name == "arrow" -%}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- elif name == "lock" -%}<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
{%- elif name == "bolt" -%}<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>
{%- elif name == "gift" -%}<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/>
{%- elif name == "wifi-off" -%}<path d="M2 2l20 20M8.5 16.5a5 5 0 0 1 7 0M5 13a10 10 0 0 1 5.2-2.8M19 13a10 10 0 0 0-2-1.5M2 8.8a15 15 0 0 1 4.2-2.6M22 8.8A15 15 0 0 0 11 5"/><circle cx="12" cy="20" r=".6" fill="currentColor"/>
{%- elif name == "check" -%}<path d="M20 6 9 17l-5-5"/>
{%- elif name == "sun" -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
{%- elif name == "moon" -%}<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
{%- elif name == "menu" -%}<path d="M4 6h16M4 12h16M4 18h16"/>
{%- elif name == "search" -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
{%- elif name == "server" -%}<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>
{%- elif name == "laptop" -%}<rect x="4" y="4" width="16" height="11" rx="2"/><path d="M2 19h20"/>
{%- elif name == "shrink" -%}<path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/>
{%- elif name == "maximize" -%}<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
{%- elif name == "download" -%}<path d="M12 4v12M7 11l5 5 5-5M4 20h16"/>
{%- elif name == "x" -%}<path d="M18 6 6 18M6 6l12 12"/>
{%- endif -%}
</svg>
{%- endmacro -%}

{%- macro wren(size=32) -%}
<svg class="wren" width="{{ size }}" height="{{ size }}" viewBox="0 0 64 64" aria-hidden="true">
  <path fill="var(--wren-body)" d="M18 37 6.5 12.5c-.9-2 1.2-3.6 2.9-2.3L24 30z"/>
  <ellipse cx="30" cy="40" rx="17" ry="12.5" fill="var(--wren-body)"/>
  <circle cx="44" cy="26" r="9.5" fill="var(--wren-body)"/>
  <path fill="var(--wren-wing)" d="M21 38c6-7 15-8 21-3.5-4 8.5-12 11.5-19 9.5-2.6-.8-3.6-4-2-6z"/>
  <path fill="var(--wren-beak)" d="m52.5 23 9 2.8-9 2.7z"/>
  <circle cx="47" cy="24" r="1.9" fill="var(--wren-eye)"/>
  <path stroke="var(--wren-beak)" stroke-width="2.2" stroke-linecap="round" d="m27 52-1.5 6M34 52l1 6"/>
</svg>
{%- endmacro -%}
