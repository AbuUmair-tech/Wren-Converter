---
layout: layouts/base.njk
pagination:
  data: categories
  size: 1
  alias: cat
permalink: "/{{ cat.slug }}-converter/"
eleventyComputed:
  title: "{{ cat.title }}: free and private"
  description: "Convert {{ cat.examples | join(', ') }} files in your browser. Free, no upload, no sign-up."
---
{%- from "icons.njk" import icon -%}
{%- set catTools = tools | inCategory(cat.slug) %}

<section class="page-hero">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">{{ cat.title }}</span></nav>
    <div class="page-hero-grid">
      <div>
        <span class="cat-icon cat-{{ cat.slug }} cat-icon-lg">{{ icon(cat.icon, 28) }}</span>
        <h1>{{ cat.title }}</h1>
        <p class="lede">{{ cat.blurb }} Everything runs in your browser, so your files are never uploaded.</p>
      </div>
      {%- if cat.live %}
      <div>
        {%- set dz = { from: cat.demo[0], to: cat.demo[1] } %}
        {% include "dropzone.njk" %}
      </div>
      {%- endif %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {%- if catTools.length %}
    <h2>Popular {{ cat.name | lower }} tools</h2>
    <ul class="tool-list">
      {%- for t in catTools | where("popular", true) %}
      <li>
        <a class="tool-row" href="/{{ t.slug }}/">
          <span class="tool-row-name">{{ t | toolName }}</span>
          <span class="tool-row-desc">{{ t.summary }}</span>
          {{ icon("arrow", 18) }}
        </a>
      </li>
      {%- endfor %}
    </ul>

    {%- set catGroup = catalog.groups | bySlug(cat.slug) %}
    <h2 class="all-pairs-title">Every {{ cat.name | lower }} conversion</h2>
    <div class="pair-index">
      {%- for f in catGroup.formats %}
      {%- set fromTools = catTools | where("from", f) %}
      {%- if fromTools.length %}
      <div class="pair-index-row">
        <h3><span class="fmt fmt-{{ f | lower }}">{{ f | fmt }}</span> to</h3>
        <ul class="chip-list chip-list-sm">
          {%- for t in fromTools %}<li><a href="/{{ t.slug }}/">{{ t.to | fmt }}</a></li>{% endfor %}
        </ul>
      </div>
      {%- endif %}
      {%- endfor %}
    </div>
    {%- else %}
    <div class="coming">
      <span class="badge {% if cat.phase <= 4 %}badge-new{% else %}badge-muted{% endif %}">{% if cat.phase <= 4 %}Coming next{% else %}Planned{% endif %}</span>
      <h2>{{ cat.title }} is on its way</h2>
      <p>We are building the {{ cat.name | lower }} tools now. They will handle {{ cat.examples | join(", ") }} and more, all without uploading your files.</p>
      <a class="btn" href="/image-converter/">Try the image converter {{ icon("arrow", 16) }}</a>
    </div>
    {%- endif %}
  </div>
</section>
