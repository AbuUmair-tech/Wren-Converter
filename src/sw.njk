// WrenConvert service worker: keeps the converter working offline.
// Pages and scripts: network first, cached copy when offline.
// Codec bundles (large, change only when rebuilt): cache first.
const VERSION = '{{ "" | buildId }}';
const CACHE = `wren-${VERSION}`;
const CORE = ['/', '/assets/css/main.css', '/assets/js/main.js', '/assets/js/catalog.js', '/assets/js/engine.js',
  '/assets/fonts/inter-latin-wght-normal.woff2', '/assets/img/favicon.svg'];

self.addEventListener('install', (e) => {
  e.waitUntil(caches.open(CACHE).then((c) => c.addAll(CORE)).then(() => self.skipWaiting()));
});

self.addEventListener('activate', (e) => {
  e.waitUntil(caches.keys()
    .then((keys) => Promise.all(keys.filter((k) => k.startsWith('wren-') && k !== CACHE).map((k) => caches.delete(k))))
    .then(() => self.clients.claim()));
});

self.addEventListener('fetch', (e) => {
  const req = e.request;
  const url = new URL(req.url);
  if (req.method !== 'GET' || url.origin !== location.origin) return;

  if (url.pathname.startsWith('/assets/vendor/') || url.pathname.startsWith('/assets/fonts/')) {
    e.respondWith(caches.open(CACHE).then(async (c) => {
      const hit = await c.match(req);
      if (hit) return hit;
      const res = await fetch(req);
      if (res.ok) c.put(req, res.clone());
      return res;
    }));
    return;
  }

  e.respondWith(fetch(req).then((res) => {
    if (res.ok && res.type === 'basic') {
      const copy = res.clone();
      caches.open(CACHE).then((c) => c.put(req, copy));
    }
    return res;
  }).catch(async () => (await caches.match(req, { ignoreSearch: true })) || caches.match('/')));
});
